# ===== Bắt buộc =====
ANTHROPIC_API_KEY=sk-ant-...
ADMIN_TOKEN=doi-thanh-chuoi-bi-mat-dai
PUBLIC_URL=https://shop-ai.example.com
PORT=3000

# ===== Claude =====
CLAUDE_MODEL=claude-opus-5-5
# Mức suy nghĩ khi chat với khách: low | medium | high
CHAT_EFFORT=medium
GRADE_EFFORT=medium

# ===== Facebook Messenger =====
FB_APP_ID=
FB_APP_SECRET=
# Chỉ dùng khi nối 1 Trang bằng token dán tay; nhiều Trang thì bấm "Kết nối Facebook" trên dashboard
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=eiv-verify

# ===== Zalo OA =====
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET_KEY=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
# ID Zalo của chủ shop (nhắn /id cho OA để lấy), cách nhau dấu phẩy
ZALO_OWNER_IDS=
# Mã trong thẻ meta Zalo đưa khi xác thực domain (chỉ phần content="...")
ZALO_SITE_VERIFICATION=

# ===== Lark (điều khiển) =====
LARK_APP_ID=
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=
# Chat ID nhóm/1-1 được phép điều khiển (nhắn bot 1 lần để lấy)
LARK_OWNER_CHAT_IDS=
# Feishu Trung Quốc: https://open.feishu.cn
LARK_DOMAIN=https://open.larksuite.com

# ===== Lưu trữ =====
# Trên Railway/VPS: trỏ vào ổ đĩa bền vững, vd /data/db.json
DATA_FILE=

# ===== Hành vi =====
HUMAN_TAKEOVER_MINUTES=30
LEARNING_INTERVAL_MINUTES=30
CONVERSATION_IDLE_MINUTES=30
HISTORY_LIMIT=30
